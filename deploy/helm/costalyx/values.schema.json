{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "backend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
        "scheduler": {
          "type": "object",
          "required": ["enabled", "intervalMs", "ingestionEnabled"],
          "properties": {
            "enabled": { "type": "string", "enum": ["enabled"] },
            "intervalMs": { "type": "string", "pattern": "^[0-9]+$" },
            "ingestionEnabled": { "type": "string", "enum": ["", "enabled"] }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["appEnv", "keycloakIssuerUrl", "keycloakJwksUrl", "vaultAddr", "useMocks", "seedFixtureData"],
      "properties": {
        "appEnv": { "type": "string", "minLength": 1 },
        "keycloakIssuerUrl": { "type": "string", "minLength": 1 },
        "keycloakJwksUrl": { "type": "string", "minLength": 1 },
        "vaultAddr": { "type": "string", "minLength": 1 },
        "redpandaBrokers": { "type": "string" },
        "liveCloudProbes": { "type": "string" },
        "awsBrokerPrincipalArn": { "type": "string" },
        "awsProbeRegion": { "type": "string" },
        "useMocks": { "type": "string", "enum": ["false"] },
        "seedFixtureData": { "type": "string", "enum": ["false"] }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "databaseUrlKey", "vaultTokenKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "databaseUrlKey": { "type": "string", "minLength": 1 },
        "vaultTokenKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
