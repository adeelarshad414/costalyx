{
  "realm": "costalyx-dev",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Can view scoped cost data" },
      { "name": "analyst", "description": "Can edit tags and apply recommendations" },
      { "name": "admin", "description": "Can manage accounts, users, and credentials" }
    ]
  },
  "clients": [
    {
      "clientId": "costalyx-web",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "protocolMappers": [
        {
          "name": "costalyx-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "costalyx-web",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
